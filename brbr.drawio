graph TD
    %% Стили для красоты
    classDef sensor fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px,color:#000
    classDef logic fill:#fff2cc,stroke:#d6b656,stroke-width:2px,color:#000
    classDef alarm fill:#f8cecc,stroke:#b85450,stroke-width:2px,color:#000
    classDef safe fill:#d5e8d4,stroke:#82b366,stroke-width:2px,color:#000
    classDef radio fill:#e1d5e7,stroke:#9673a6,stroke-width:2px,color:#000
    classDef action fill:#ffe6cc,stroke:#d79b00,stroke-width:2px,color:#000

    %% --- СТАНЦИЯ ---
    subgraph STATION [Станция - Arduino Mega 2560]
        direction TB
        S1[Опрос датчиков: O2, CO, CH4, Пыль]:::sensor --> S2[Обработка данных контроллером]:::logic
        S2 --> S3{Порог превышен?}:::logic
        S3 -- Да --> S4[Фиксация тревоги alarmLatched = true]:::alarm
        S3 -- Нет --> S5[Показатели в норме]:::safe
        S4 --> S6[Включить красный RGB + Сирену]:::alarm
        S5 --> S7[Включить зеленый RGB]:::safe
    end

    %% --- РАДИОКАНАЛ ---
    S6 ==>|LoRa 433 МГц: Тревога| R1
    S7 ==>|LoRa 433 МГц: Норма| R1

    %% --- НОСИМОЕ УСТРОЙСТВО ---
    subgraph WEARABLE [Носимое устройство - Arduino Nano]
        direction TB
        R1[Прием сигнала LoRa]:::radio --> R2{Тип сигнала?}:::logic
        R2 -- Тревога --> R3[Включить: Красный LED, Вибромотор, Звук]:::alarm
        R2 -- Норма --> R4[Включить: Зеленый LED, остальное выкл.]:::safe
        R3 --> R5[Шахтер нажимает кнопку Сброс]:::action
        R5 --> R6[Отключение сигналов тревоги]:::safe
    end
